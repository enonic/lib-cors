{
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24.16.0",
    "pnpm": ">=10.33.4"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm build:dev",
    "build:prod": "cross-env NODE_ENV=production node esbuild.config.js",
    "build:dev": "node esbuild.config.js",
    "check": "pnpm check:lint && pnpm check:types",
    "check:lint": "biome check .",
    "check:types": "tsc --noEmit",
    "test": "node --test src/test/node/util.test.ts",
    "fix": "biome check . --fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.4",
    "@enonic-types/core": "^8.0.3",
    "@enonic-types/global": "^8.0.3",
    "cross-env": "^10.1.0",
    "esbuild": "~0.28.1",
    "husky": "^9.1.7",
    "typescript": "~5.8.3"
  }
}
