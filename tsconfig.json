{
    "compilerOptions": {
        "target": "ES5",
        "module": "CommonJS",
        "moduleResolution": "node",
        "lib": ["ES5"],
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "typeRoots": [
            "./node_modules/@types",
            "./node_modules/@enonic-types"
        ],
        "types": ["core", "global"]
    },
    "include": ["src/main/resources/**/*.ts"]
}
